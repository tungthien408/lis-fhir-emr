{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "npm run dev:lis",
    "dev:lis": "npm run dev --workspace apps/lis",
    "dev:monitor": "npm run dev --workspace apps/middleware-monitor",
    "dev:emr": "npm run dev --workspace apps/emr",
    "build": "npm run build --workspaces",
    "build:lis": "npm run build --workspace apps/lis",
    "build:monitor": "npm run build --workspace apps/middleware-monitor",
    "build:emr": "npm run build --workspace apps/emr",
    "check": "npm run check --workspaces",
    "lint": "eslint .",
    "preview": "npm run preview:lis",
    "preview:lis": "npm run preview --workspace apps/lis",
    "preview:monitor": "npm run preview --workspace apps/middleware-monitor",
    "preview:emr": "npm run preview --workspace apps/emr"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
