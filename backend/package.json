{
  "name": "lis-fhir-emr",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "3 dich vu doc lap ket noi PostgreSQL + Drizzle; chua co nghiep vu trao doi",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "concurrently -k -n LIS,MIDDLEWARE,EMR \"npm:dev:lis\" \"npm:dev:middleware\" \"npm:dev:emr\"",
    "dev:lis": "node --env-file-if-exists=../.env --import tsx --watch src/lis/main.ts",
    "dev:lis-dispatcher": "node --env-file-if-exists=../.env --import tsx src/lis/dispatcher-main.ts",
    "dev:middleware": "node --env-file-if-exists=../.env --import tsx --watch src/middleware/main.ts",
    "dev:middleware-worker": "node --env-file-if-exists=../.env --import tsx src/middleware/worker-main.ts",
    "dev:emr": "node --env-file-if-exists=../.env --import tsx --watch src/emr/main.ts",
    "check": "tsc --noEmit && tsc --project tsconfig.test.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/lis/*.test.ts",
    "test:middleware": "node --import tsx --test --test-concurrency=1 tests/middleware/*.test.ts",
    "test:mapper": "node --import tsx --test tests/middleware/mapper.test.ts",
    "test:worker": "node --import tsx --test --test-concurrency=1 tests/middleware/worker*.test.ts",
    "test:lis-dispatch": "node --import tsx --test --test-concurrency=1 tests/lis/dispatcher*.test.ts",
    "test:lis-dispatch:postgres": "node ../scripts/test-repositories-postgres.mjs --lis-dispatch-only",
    "test:emr": "node --import tsx --test --test-concurrency=1 tests/emr/*.test.ts",
    "test:emr:postgres": "node ../scripts/test-repositories-postgres.mjs --emr-only",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:integration:postgres": "node ../scripts/test-repositories-postgres.mjs --real-emr-only",
    "test:e2e": "node --import tsx --test --test-concurrency=1 tests/e2e/*.test.ts",
    "test:e2e:postgres": "node ../scripts/test-repositories-postgres.mjs --e2e-only",
    "test:repositories:postgres": "node ../scripts/test-repositories-postgres.mjs",
    "build": "tsc",
    "start:lis": "node --env-file-if-exists=../.env dist/lis/main.js",
    "start:lis-dispatcher": "node --env-file-if-exists=../.env dist/lis/dispatcher-main.js",
    "start:middleware": "node --env-file-if-exists=../.env dist/middleware/main.js",
    "start:middleware-worker": "node --env-file-if-exists=../.env dist/middleware/worker-main.js",
    "start:emr": "node --env-file-if-exists=../.env dist/emr/main.js",
    "smoke": "node --env-file-if-exists=../.env ../scripts/smoke-test.mjs",
    "db:check": "node --env-file-if-exists=../.env ../scripts/db-check.mjs",
    "verify:sql": "node ../scripts/verify-sql.mjs",
    "spp82:dry-run": "node --env-file-if-exists=../.env --import tsx scripts/spp82/publish-runner-main.ts --dry-run",
    "ops:requeue-failed": "node --env-file-if-exists=../.env --import tsx scripts/ops/requeue-failed.ts",
    "spp82:verify": "node --import tsx scripts/spp82/verification/verification-main.ts verify",
    "spp82:capture": "node --import tsx scripts/spp82/verification/verification-main.ts capture",
    "test:ops": "node --import tsx --test scripts/ops/*.test.ts",
    "test:spp82:verify": "node --import tsx --test scripts/spp82/verification/*.test.ts",
    "test:spp82": "node --import tsx --test --test-concurrency=1 scripts/spp82/*.test.ts scripts/spp82/verification/*.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "pg": "8.23.1",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.5",
    "@types/pg": "8.23.1",
    "@types/swagger-ui-express": "4.1.8",
    "concurrently": "9.2.1",
    "openapi-types": "12.1.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
