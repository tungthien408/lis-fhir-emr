# PostgreSQL admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME

# Service database accounts
LIS_DB_PASSWORD=CHANGE_ME
MIDDLEWARE_DB_PASSWORD=CHANGE_ME
EMR_DB_PASSWORD=CHANGE_ME

# Worker is a separate, opt-in process. Real EMR POST/GET are still pending.
# Host example; the Compose worker profile overrides this with its Docker URL.
EMR_BASE_URL=http://127.0.0.1:3103
MIDDLEWARE_WORKER_HTTP_TIMEOUT_MS=3000
MIDDLEWARE_WORKER_LEASE_MS=15000
MIDDLEWARE_WORKER_POLL_MS=1000
MIDDLEWARE_WORKER_RETRY_DELAYS_MS=2000,4000,8000

