# PostgreSQL admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME

# Service database accounts (PostgreSQL dacn_db)
LIS_DB_PASSWORD=CHANGE_ME
MIDDLEWARE_DB_PASSWORD=CHANGE_ME
EMR_DB_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# Background Process Configurations (Opt-in processes)
# -----------------------------------------------------------------------------
# Note on URLs:
# - Running locally on host (npm run dev:*): Use 127.0.0.1 (e.g., http://127.0.0.1:3102)
# - Running inside Docker Compose: Compose defaults to Docker service names
#   (http://middleware:3102 and http://emr:3103 via compose.yaml)

# LIS Dispatcher: reads lis.publish_events outbox and dispatches to Middleware
MIDDLEWARE_BASE_URL=http://127.0.0.1:3102
# Optional Dispatcher tuning:
# LIS_DISPATCHER_HTTP_TIMEOUT_MS=3000
# LIS_DISPATCHER_LEASE_MS=15000
# LIS_DISPATCHER_POLL_MS=1000
# LIS_DISPATCHER_MAX_ATTEMPTS=4
# LIS_DISPATCHER_RETRY_DELAYS_MS=2000,4000,8000

# Middleware Worker: transforms exchange payload to FHIR R4 Observation and delivers to EMR
EMR_BASE_URL=http://127.0.0.1:3103
# Optional Worker tuning:
# MIDDLEWARE_WORKER_HTTP_TIMEOUT_MS=3000
# MIDDLEWARE_WORKER_LEASE_MS=15000
# MIDDLEWARE_WORKER_POLL_MS=1000
# MIDDLEWARE_WORKER_RETRY_DELAYS_MS=2000,4000,8000

LIS_DATABASE_URL=postgresql://lis_app:<LIS_DB_PASSWORD>@127.0.0.1:5433/dacn_db
MIDDLEWARE_DATABASE_URL=postgresql://integration_app:<MIDDLEWARE_DB_PASSWORD>@127.0.0.1:5433/dacn_db